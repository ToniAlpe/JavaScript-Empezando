"<li>"+coche[0]+"</li>"+
"<li>"+coche[1]+"</li>"+
"<li>"+coche[2]+"</li>"+
"<li>"+coche [3]+"</li>"+
"</ul>");

let coche=["Leon", "Seat", 5, "V6"];
