//--- IF, ELSE IF y ELSE ---
let semaforo = "verde";

if (semaforo === "verde") {
console.log("Puede pasar");
} else if (semaforo === "rojo") {
    console.log("No puedes pasar");
} else {
    console.log("Puedes pasar pero con cuidado");
}

//--- SWITCH ---

semaforo = "Verde"

switch (true) {
    case semaforo === "Verde":
        console.log("Puedes pasar");
    break;
    case semaforo === "Amarillo":
        console.log("Puedes pasar pero con cuidado");
    break;
    case semaforo === "Rojo":
        console.log("No puedes pasar");
    break;
}

let a = 10;
let b = 5;

let mayor;

if (a > b) {
mayor = a; // Si a es mayor que b, asigna a
} else {
mayor = b; // Si no, asigna b
}
console.log(mayor); // 10 (porque a > b)

//Esto de aqui abajo es lo mismo solo que es un ternario

mayor = a > b ? a : b; // Si a > b, asigna a; de lo contrario, asigna b
console.log(mayor); // 10 (porque a > b)

//--- MATH.RANDOM ---

//1
let numeroAleatorio = Math.random();
console.log(numeroAleatorio); // Ejemplo: 0.3273948374

//imagina que quiero un numero entre el 5 y el 15. (restar el maximo menos ell minimo mas 1 y luego lo que te de le sumas el minimo)

//2
let numeroAleatorioEntero=numeroAleatorio*((15-5+1)+5);
console.log(numeroAleatorioEntero); // Ejemplo: 8.9567763

//Ahora toca quitarle los decimales

//3
let numeroAleatorioEnteroSinDec = Math.floor(numeroAleatorioEntero) //El math.floor t elo redondea para abajo (por eso la importancia de antes de sumar 1)
console.log(numeroAleatorioEnteroSinDec); // Ejemplo: 8

