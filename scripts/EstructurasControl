//-- Modificar un array --

//Recuerdas el array de German, Martinez... Pues lo he cambiado

//Podemos cambiar directamente el Array dándole nuevos valores
array=["Antonio", "Martinez", "paquete", 16, false]
console.log(array);

//Podemos modificar valores dentro de nuestro Array.
array[1]="Almagro"
console.log(array);
console.log(array.length); //5

//Y podemos añadir datos de manera fácil y sencilla
array[5]="Dato nuevo"
console.log(array);
console.log(array.length); //6

//Otra manera (es como si estuvieras haciendo el arry[6] = "Dato nuevo nuevo")
array[(array.length)]="Dato nuevo nuevo"
console.log(array);

//No se puede eliminar elementos del Array de manera directa, hay que utilizar el metodo splice

//-- Metodos 1 --
//push, pop, unshift y shift
let elementos = ["a", "b", "c"];
elementos.push("d"); // ['a', 'b', 'c', 'd'] Añade un nuevo elemento al FINAL del array y devuelve la longitud de esta
elementos.pop(); // ['a', 'b', 'c'] Elimina el ULTIMO elemento y devuelve el array
elementos.unshift("Z"); // ['Z', 'a', 'b', 'c'] Añade uno o varios elementos al PRINCIPIO del array y devuelve la nueva longitud
elementos.shift(); // ['a', 'b', 'c'] Elimina el PRIMER elemento y devuelve el array

//-- Eliminar varios elementos --

let numero = [0,1,2,3,4];
array.splice(1, 3); // Elimina 3 elementos desde la posición 1 (posicion, elementos)
console.log(array); // [0, 4]

//-- Ordenar elemntos --

let numero1 = [0,6,8,2,4];
array.sort(); // Ordena los elementos, también funciona con letras
console.log(array); // [0, 2, 4, 6, 8]

//-- Concatenar elemntos

let numeros1 = [0,6,8,2,4];
let numeros2= [1,2,5,6,9]
let arrayTotal=numeros1.concat(numeros2); // Une los dos arrays.
console.log(arrayTotal); //[0, 6, 8, 2, 4, 1, 2, 5, 6, 9]

//-- Usos de arrays en el DOM

